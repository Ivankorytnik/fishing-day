+  const sameCity=all.filter(([,d])=>String(d.city||d.catches?.[0]?.city||"").trim().toLocaleLowerCase("ru-RU")===cityNorm);
+  const sample=(cityNorm&&sameCity.length>=5?sameCity:all).slice(0,40);
+
+  if(!sample.length)return {days:0,success:0,rate:null,adjustment:0,cap:88};
+
+  const anyCatch=sample.filter(([,d])=>(d.catches||[]).some(c=>Number(c.qty||0)>0)).length;
+  const selectedSuccess=sample.filter(([,d])=>{
+    const catches=d.catches||[];
