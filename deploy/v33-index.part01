+    if(fishName!=="Общий")adjustment+=clamp(Math.round((speciesRate-speciesPrior)*14),-4,4);
+  }
+  adjustment=clamp(adjustment,-10,7);
+
+  let cap=88;
+  if(n>=6&&overallRate<.22)cap=58;
+  else if(n>=6&&overallRate<.32)cap=66;
+  else if(n>=8&&overallRate<.40)cap=72;
+
+  return {
+    days:n,
+    success:fishName==="Общий"?anyCatch:selectedSuccess,
+    anyCatch,
+    rate:fishName==="Общий"?overallRate:speciesRate,
+    overallRate,
+    adjustment,
+    cap
+  };
