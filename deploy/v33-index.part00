+function forecastMonth(value){
+  const m=String(value||"").match(/^\d{4}-(\d{2})-/);
+  return m?clamp(Number(m[1]),1,12):new Date().getMonth()+1;
+}
+function seasonScoreForFish(value,profile){
+  const month=forecastMonth(value);
+  const score=Number(profile?.season?.[month-1]);
+  return Number.isFinite(score)?score:0;
+}
