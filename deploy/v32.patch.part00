     .condition-cold{background:#edf3f6;border-color:#d6e2e8;color:#365a6b}
     .condition-warm{background:#fff0d8;border-color:#f0d3a7;color:#855814}
 
+    .hero{padding:17px 20px;border-radius:18px;margin-bottom:12px}
